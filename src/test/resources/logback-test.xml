<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Test output belongs to Gradle's captured console, never client.log. -->
    <appender name="TEST_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="TEST_CONSOLE"/>
    </root>
</configuration>
